  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "jsx": "preserve", "skipLibCheck": true, "noEmit": true,
    "lib": ["ES2020", "DOM"], "types": ["vite/client"], "isolatedModules": true
